{
  "permissions": {
    "allow": ["Read", "Edit"],
    "deny": ["Bash(rm -rf /*)"]
  },
  "hooks": {
    "PreToolUse": [{"type": "command", "command": "echo claude-base-pre-tool"}],
    "PostToolUse": [{"type": "command", "command": "echo claude-base-post-tool"}],
    "SessionStart": [{"type": "command", "command": "echo claude-base-session"}],
    "Setup": [{"type": "command", "command": "echo claude-only-setup"}],
    "UserPromptExpansion": [{"type": "command", "command": "echo claude-only-prompt-expansion"}],
    "PermissionRequest": [{"type": "command", "command": "echo claude-only-permission-request"}],
    "PostToolBatch": [{"type": "command", "command": "echo claude-only-post-batch"}],
    "Notification": [{"type": "http", "url": "https://hooks.example.com/notify"}],
    "SubagentStart": [{"type": "mcp_tool", "server": "monitor", "tool": "log_subagent"}],
    "Stop": [{"type": "command", "command": "echo claude-base-stop", "force": true}]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude",
    "pr": "Generated by Claude"
  },
  "worktree": {
    "baseRef": "main"
  },
  "allowedMcpServers": ["sonarqube", "gitlab"],
  "deniedMcpServers": ["unsafe-server"]
}
