{
  "hooks": {
    "PostToolUse": [
      {
        "action": "log",
        "matcher": "Write(**)"
      }
    ],
    "PreToolUse": [
      {
        "action": "deny",
        "matcher": "Write(**/secrets/**)"
      }
    ]
  },
  "mcpServers": {
    "jira": {
      "command": "npx",
      "args": ["jira-mcp-server"],
      "env": {"JIRA_TOKEN": "${JIRA_TOKEN}"}
    }
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git:*)",
      "Bash(rg:*)",
      "Bash(npm:*)",
      "Bash(find:*)"
    ]
  }
}
